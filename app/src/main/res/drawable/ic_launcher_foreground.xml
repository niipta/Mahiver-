<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Graduation Cap (Mortarboard) — represents "Mahir" (expert/mastery) -->

    <!-- Mortarboard top (diamond shape) -->
    <path
        android:pathData="M 54 28 L 84 42 L 54 56 L 24 42 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="24" android:startY="42" android:endX="84" android:endY="42" android:type="linear">
                <item android:color="#D4A853" android:offset="0.0" />
                <item android:color="#F0D080" android:offset="0.5" />
                <item android:color="#B08433" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mortarboard bottom edge (shadow) -->
    <path
        android:pathData="M 54 56 L 84 42 L 84 45 L 54 59 L 24 45 L 24 42 Z"
        android:fillColor="#8B6914" />

    <!-- Cap base (rounded trapezoid below the board) -->
    <path
        android:pathData="M 38 56 L 70 56 Q 72 56 72 60 L 72 72 Q 72 78 66 78 L 42 78 Q 36 78 36 72 L 36 60 Q 36 56 38 56 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="36" android:startY="56" android:endX="36" android:endY="78" android:type="linear">
                <item android:color="#B08433" android:offset="0.0" />
                <item android:color="#8B6914" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Book pages line on cap base (represents studying) -->
    <path
        android:pathData="M 42 64 L 66 64"
        android:strokeColor="#D4A853"
        android:strokeWidth="1.5" />
    <path
        android:pathData="M 42 68 L 66 68"
        android:strokeColor="#D4A853"
        android:strokeWidth="1.5" />

    <!-- Tassel string -->
    <path
        android:pathData="M 78 42 L 78 58"
        android:strokeColor="#D4A853"
        android:strokeWidth="2" />

    <!-- Tassel knot -->
    <path
        android:pathData="M 76 56 L 80 56 L 80 60 L 76 60 Z"
        android:fillColor="#D4A853" />

    <!-- Tassel strands -->
    <path
        android:pathData="M 76 60 L 75 70 M 77 60 L 77 72 M 78 60 L 79 72 M 80 60 L 81 70"
        android:strokeColor="#F0D080"
        android:strokeWidth="1.2" />

    <!-- Star sparkle (top left — represents achievement) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 30 30 L 31 33 L 34 34 L 31 35 L 30 38 L 29 35 L 26 34 L 29 33 Z" />

    <!-- Small star (top right) -->
    <path
        android:fillColor="#FFF8E1"
        android:pathData="M 76 26 L 76.5 27.5 L 78 28 L 76.5 28.5 L 76 30 L 75.5 28.5 L 74 28 L 75.5 27.5 Z" />
</vector>
